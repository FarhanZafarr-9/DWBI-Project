# Keep binary deliverables byte-for-byte intact (no line-ending conversion, no diffs)
*.pdf  binary
*.xlsx binary
*.dat  binary

# Normalize text sources to LF in the repository and in checkouts
*.csv  text eol=lf
*.dbml text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.txt  text eol=lf
